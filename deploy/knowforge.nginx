server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # 前端静态文件（Vite 构建产物）
    root /opt/knowforge/quiz-web/dist;
    index index.html;

    # gzip：JS/CSS/JSON/SVG 压缩 60-80%，慢带宽客户端首屏明显加快
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/wasm;

    # SPA 路由兜底：刷新子路由不 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反代（同源，浏览器走 http://39.98.69.153/api/v1，无需 CORS）
    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 健康检查直连后端
    location = /health {
        proxy_pass http://127.0.0.1:8001/health;
    }
}
