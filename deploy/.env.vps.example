# VPS 部署环境变量模板：复制为 deploy/.env.vps 并填入真实值（.env.vps 已 gitignore）
APP_NAME=quiz-server
API_PREFIX=/api/v1
DEBUG=false

# Turso (libSQL)：authToken 从 Turso 控制台 Databases -> knowforge -> Generate Token 获取
DB_URL=libsql://<your-db-host>.turso.io?authToken=<your-auth-token>
DB_ECHO=false

# 同源部署：前端与 API 同域（nginx 反代），CORS 仅作保险
CORS_ORIGINS=["http://<vps-ip>"]

PORT=8001

SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_MB=128
CLEAR_STREAK=2
HEARTBEAT_TIMEOUT_SEC=300
