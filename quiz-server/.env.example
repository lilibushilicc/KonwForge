APP_NAME=quiz-server
API_PREFIX=/api/v1
# 生产（Render）设为 false；本地开发可留 true
DEBUG=false

# 数据库：本地用 SQLite，上云用 Neon（serverless PostgreSQL）
# Neon 连接串示例（从 Neon 控制台 Dashboard 复制，含 sslmode=require）：
#   DB_URL=postgresql+psycopg://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# 本地 PostgreSQL：
#   DB_URL=postgresql+psycopg://quiz:quiz_dev_pw@127.0.0.1:5432/quiz
# 本地 SQLite（默认）：
DB_URL=sqlite:///./data/quiz.db
DB_ECHO=false

# 跨域白名单：支持 JSON 数组或逗号分隔
#   CORS_ORIGINS=["https://quiz.example.com"]
#   CORS_ORIGINS=https://quiz.example.com,https://www.example.com
CORS_ORIGINS=["http://localhost:5173"]

# Render 注入的监听端口，本地默认 8001，无需手动设置
PORT=8001

SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_MB=128

CLEAR_STREAK=2
HEARTBEAT_TIMEOUT_SEC=300
